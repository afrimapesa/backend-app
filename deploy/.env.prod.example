# Copy to .env.prod ON THE SERVER and fill in. Never commit .env.prod.

# The address the preview is served at (add the Namecheap cPanel A record first).
DOMAIN=preview.afrimapesa.com

# Preview login. Create the hash with:
#   docker run --rm caddy:2-alpine caddy hash-password --plaintext 'the-password'
# Keep the single quotes: the hash contains $ characters.
PREVIEW_USER=afrimapesa
PREVIEW_PASSWORD_HASH='$2a$14$replace-with-the-generated-hash'

# Generate each with:  openssl rand -base64 48 | tr -d '\n/+='
DJANGO_SECRET_KEY=replace-me
POSTGRES_PASSWORD=replace-me

# --- Live mid-market FX feeds (each runs only when its key is set) -----------------------
# Open Exchange Rates covers everything on its own (USD base; other pairs are derived
# through USD). ExchangeRate-API and CurrencyFreaks add direct EUR and GBP rates.
OPEN_EXCHANGE_RATES_APP_ID=
EXCHANGE_RATE_API_KEY=
EXCHANGE_RATE_API_BASE=EUR
CURRENCY_FREAKS_API_KEY=
# A non-USD base needs a paid CurrencyFreaks plan.
CURRENCY_FREAKS_BASE=GBP
# Free plans allow ~1,000-1,500 calls a month: keep 60 (hourly). Paid plans: 5.
FX_REFRESH_MINUTES=60
# Rates older than this are not used for comparisons. Hourly plans: 150. 5-minute: 30.
FX_MID_MAX_AGE_MINUTES=150
# Set to --quotes-only once a feed key is set (sample quotes then use live rates).
SAMPLER_FLAGS=

# Where the frontend repo is checked out, relative to this deploy/ folder.
FRONTEND_DIR=../../frontend-app

# Optional overrides for the social links (defaults are built into the frontend).
NEXT_PUBLIC_TIKTOK_URL=
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_FACEBOOK_URL=
