# Copy to .env.prod ON THE SERVER and fill in. Never commit .env.prod.

# The address the preview is served at (add the Namecheap cPanel A record first).
DOMAIN=preview.afrimapesa.com
# Let's Encrypt contact for certificate expiry notices.
ACME_EMAIL=you@example.com

# Preview login. Create the hash with:
#   docker run --rm caddy:2-alpine caddy hash-password --plaintext 'the-password'
# Keep the single quotes: the hash contains $ characters.
PREVIEW_USER=afrimapesa
PREVIEW_PASSWORD_HASH='$2a$14$replace-with-the-generated-hash'

# Generate each with:  openssl rand -base64 48 | tr -d '\n/+='
DJANGO_SECRET_KEY=replace-me
POSTGRES_PASSWORD=replace-me

# Where the frontend repo is checked out, relative to this deploy/ folder.
FRONTEND_DIR=../../frontend-app

# Optional overrides for the social links (defaults are built into the frontend).
NEXT_PUBLIC_TIKTOK_URL=
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_FACEBOOK_URL=
