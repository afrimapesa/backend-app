# Certificates come from Let's Encrypt automatically; no contact email is required.

# One domain for everything: Django under /v1, /admin, /static, /health; Next.js for the rest.
{$DOMAIN} {
	encode zstd gzip

	# Private preview: password on the whole site, and keep it out of search engines.
	basic_auth {
		{$PREVIEW_USER} {$PREVIEW_PASSWORD_HASH}
	}
	header {
		X-Robots-Tag "noindex, nofollow"
		Strict-Transport-Security "max-age=31536000"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	# The preview login is only a gate: don't forward it, or Django REST Framework would try to
	# use it as a Django account login and reject every API call.
	@django path /v1/* /admin /admin/* /static/* /health/
	handle @django {
		reverse_proxy api:8000 {
			header_up -Authorization
		}
	}
	handle {
		reverse_proxy web:3000 {
			header_up -Authorization
		}
	}
}
